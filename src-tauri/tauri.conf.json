{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mon espace LocWeb",
  "mainBinaryName": "locweb-espace",
  "version": "1.0.0",
  "identifier": "fr.locweb.espace",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "NICOSERVICES",
    "homepage": "https://locweb.fr",
    "category": "Business",
    "shortDescription": "Gerez votre site et suivez vos demandes.",
    "longDescription": "Mon espace LocWeb : modifiez les textes et les photos de votre site, suivez vos visiteurs et recevez vos demandes de devis.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "linux": {
      "deb": {
        "section": "web"
      }
    }
  }
}
